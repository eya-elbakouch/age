<?xml version="1.0" encoding="UTF-8"?>

<definitions
        name="AgeService"
        targetNamespace="http://ageservice/"
        xmlns="http://schemas.xmlsoap.org/wsdl/"
        xmlns:tns="http://ageservice/"
        xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
        xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <types>
        <xs:schema targetNamespace="http://ageservice/">

            <xs:element name="getAge">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="arg0"
                                    type="xs:int"
                                    minOccurs="0"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

            <xs:element name="getAgeResponse">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="return"
                                    type="xs:string"
                                    minOccurs="0"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

        </xs:schema>
    </types>

    <message name="getAge">
        <part name="parameters" element="tns:getAge"/>
    </message>

    <message name="getAgeResponse">
        <part name="parameters" element="tns:getAgeResponse"/>
    </message>

    <portType name="AgeService">
        <operation name="getAge">
            <input message="tns:getAge"/>
            <output message="tns:getAgeResponse"/>
        </operation>
    </portType>

    <binding name="AgeServiceSOAP" type="tns:AgeService">
        <soap:binding
                style="document"
                transport="http://schemas.xmlsoap.org/soap/http"/>

        <operation name="getAge">
            <soap:operation soapAction=""/>
            <input>
                <soap:body use="literal"/>
            </input>
            <output>
                <soap:body use="literal"/>
            </output>
        </operation>
    </binding>

    <service name="AgeService">
        <port name="AgeServicePort" binding="tns:AgeServiceSOAP">
            <soap:address location="http://localhost:8080/Age/getAge"/>
        </port>
    </service>

</definitions>